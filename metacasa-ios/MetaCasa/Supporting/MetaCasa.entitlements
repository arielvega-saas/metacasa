<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Universal Links: la app reclama https://usehomefinance.com/auth/confirm
         (link de confirmación de email). Al tocarlo, iOS abre la app en vez del
         navegador y completamos la sesión con verifyOTP(token_hash). El AASA vive
         en https://usehomefinance.com/.well-known/apple-app-site-association.
         Requiere que el App ID tenga habilitada la capability "Associated Domains"
         (firma automática la agrega sola con este entitlement). -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:usehomefinance.com</string>
    </array>
    <!-- App Group compartido con la extension MetaCasaWidgets: la app escribe
         el WidgetSnapshot (balance del mes + próximo vencimiento) y el widget
         lo lee. Sin este entitlement en AMBOS targets, el widget renderiza
         vacío. Requiere el App Group creado en el Developer Portal. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.metacasa.shared</string>
    </array>
</dict>
</plist>
