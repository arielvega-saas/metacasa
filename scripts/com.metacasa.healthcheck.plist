<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.metacasa.healthcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/arielvega/dev/HomeFinance/app/scripts/healthcheck.sh</string>
        <string>--quiet</string>
    </array>

    <!-- Cada hora. Con RunAtLoad, además corre al iniciar sesión. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/Users/arielvega/dev/HomeFinance/app/.healthcheck.err.log</string>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
</dict>
</plist>
