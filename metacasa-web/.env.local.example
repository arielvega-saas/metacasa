# ─────────────────────────────────────────────────────────────
# Home Finance Web — variables de entorno
# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` está gitignored: NUNCA se commitea.
# ─────────────────────────────────────────────────────────────

# Backend Supabase (mismo proyecto que la app móvil)
NEXT_PUBLIC_SUPABASE_URL=https://rgslvrxdppphzvqgcwbx.supabase.co

# Publishable key (segura para exponer en el cliente — NO es service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública de esta web (para magic links, redirects y deep links desde la app)
# En local: http://localhost:3000 — en prod: https://metacasa-web.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOTA: la web NUNCA usa SUPABASE_SERVICE_ROLE_KEY. El service_role vive solo
# en las Edge Functions (ej. web-handoff). No lo pongas acá.
